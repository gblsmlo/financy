# Índice das variáveis de ambiente do monorepo. Nada carrega este arquivo — cada workspace lê o
# seu próprio `.env`. Copie os dois exemplos antes de subir o projeto:
#
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env

# --- backend/.env (ver backend/.env.example) ---

# Obrigatória. Assina as sessões do BetterAuth. Gere a sua com `openssl rand -base64 32`.
JWT_SECRET=troque-por-um-segredo-gerado-localmente

# Obrigatória. Caminho do SQLite, relativo a backend/.
DATABASE_URL="file:./dev.db"

# Opcionais — os valores abaixo são os defaults aplicados quando a chave não existe.
# CORS_ORIGIN=http://localhost:5173
# PORT=3333

# --- frontend/.env (ver frontend/.env.example) ---

# Obrigatória. Origem da API; o cliente GraphQL bate em ${VITE_BACKEND_URL}/graphql.
VITE_BACKEND_URL=http://localhost:3333
