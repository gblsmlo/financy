{
  "name": "financy",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "bun run --parallel --workspaces build",
    "codegen": "bun run --cwd backend schema:print && bun run --cwd frontend codegen",
    "db:generate": "bun run --cwd backend db:generate",
    "db:migrate": "bun run --cwd backend db:migrate",
    "dev": "bun run --parallel --workspaces dev",
    "dev:backend": "bun run --cwd backend dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test --isolate",
    "test:backend": "bun test --isolate backend",
    "test:coverage": "bun test --isolate --coverage",
    "test:e2e": "playwright test",
    "test:frontend": "bun test --isolate frontend",
    "test:watch": "bun test --isolate --watch",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@playwright/test": "^1.62.1",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  }
}
